{
  "name": "@claude-context-cache/context-store",
  "version": "0.1.0",
  "description": "Tiered context store for Claude Context Cache: Redis -> SQLite (memory) -> SQLite (disk), with optional MySQL/Postgres/MongoDB write-through and automatic session lifecycle.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "tsc -p tsconfig.test.json && node --test --test-reporter=spec dist-test/tests/*.test.js",
    "clean": "rm -rf dist dist-test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "context",
    "cache",
    "redis",
    "sqlite",
    "mysql",
    "postgres",
    "mongodb",
    "session",
    "store"
  ],
  "author": "Claude Context Cache",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exprsnio/claude-context-cache.git",
    "directory": "context-store"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0"
  },
  "peerDependencies": {
    "redis": "^4.7.0",
    "mysql2": "^3.11.0",
    "pg": "^8.13.0",
    "mongodb": "^6.10.0"
  },
  "peerDependenciesMeta": {
    "redis": { "optional": true },
    "mysql2": { "optional": true },
    "pg": { "optional": true },
    "mongodb": { "optional": true }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.5.0"
  }
}
