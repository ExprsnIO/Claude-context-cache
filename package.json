{
  "name": "claude-context-cache-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo root for Claude Context Cache: the ccc CLI (Python at root + Node at npm/) and the @claude-context-cache/context-store backend.",
  "workspaces": [
    "context-store",
    "npm"
  ],
  "scripts": {
    "postinstall": "npm run build",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "build:context-store": "npm run build --workspace @claude-context-cache/context-store",
    "build:npm": "npm run build --workspace claude-context-cache",
    "test:context-store": "npm run test --workspace @claude-context-cache/context-store",
    "test:npm": "npm run test --workspace claude-context-cache"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exprsnio/claude-context-cache.git"
  }
}
